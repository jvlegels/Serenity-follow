      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Signal history",
      "short_name": "History",
      "url": "/#/history",
      "description": "Open recent analysed Serenity posts"
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/#/settings",
      "description": "Open notification and source settings"
    }
  ]
}
