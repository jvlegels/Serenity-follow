{
  "name": "Serenity Follow",
  "short_name": "Serenity",
  "description": "Mobile-first monitor for public Serenity posts and potential buying-signal summaries.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f7f4ef",
  "theme_color": "#f7f4ef",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
